        "name": { "type": "string", "description": "Full name" },
        "email": { "type": "string", "description": "Email address" },
        "role": { "type": "string", "description": "Role: guest, client, freelancer, admin" },
        "avatar": { "type": "string", "description": "Avatar URL" },
        "title": { "type": "string", "description": "Professional headline" },
        "bio": { "type": "string", "description": "Bio description" },
        "hourlyRate": { "type": "number", "description": "Hourly rate in USD" },
        "rating": { "type": "number", "description": "Average review rating" },
        "reviewsCount": { "type": "number", "description": "Count of reviews" },
        "completedProjects": { "type": "number", "description": "Completed projects count" },
        "skills": { "type": "array", "description": "List of technical skills" },
