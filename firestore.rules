rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Allow read/write for marketplace data (or when authenticated)
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if true;
    }

    match /proposals/{proposalId} {
      allow read: if true;
      allow write: if true;
    }

    match /milestones/{milestoneId} {
      allow read: if true;
      allow write: if true;
    }

    match /messages/{messageId} {
      allow read: if true;
      allow write: if true;
    }

    match /projectFiles/{fileId} {
      allow read: if true;
      allow write: if true;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if true;
    }

    match /disputes/{disputeId} {
      allow read: if true;
      allow write: if true;
    }

    match /payments/{paymentId} {
      allow read: if true;
      allow write: if true;
    }

    match /settlements/{settlementId} {
      allow read: if true;
      allow write: if true;
    }

    match /notifications/{notificationId} {
      allow read: if true;
      allow write: if true;
    }

    match /portfolios/{portfolioId} {
      allow read: if true;
      allow write: if true;
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
